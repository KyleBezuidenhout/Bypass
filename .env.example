# All optional. Set any ONE to enable the paid vision layer.
# The library auto-picks the cheapest capable solver for each CAPTCHA kind.

# Cheapest paid (ML) — https://anti-captcha.com
ANTICAPTCHA_KEY=
# Cheapest paid (ML) — https://capsolver.com
CAPSOLVER_KEY=
# Broadest coverage (human workers) — https://2captcha.com
TWOCAPTCHA_KEY=

# Optional tuning
CAPTCHA_TIMEOUT=120
CAPTCHA_POLL_INTERVAL=3
# Force an order, e.g. "capsolver,anticaptcha"
CAPTCHA_PREFER=

# ---- panel lock (see upgrades-roadmap/remote-access.md) ----
# Set to switch the single-password lock ON. Unset = open panel.
# run-panel.ps1 generates and reads this for you from .panel-password.
PANEL_PASSWORD=
# Rotating the password signs everyone out. Set this to keep sessions across a
# password change (also set it so two processes agree).
PANEL_SECRET=
# Session lifetime in hours. Default 336 (14 days).
PANEL_SESSION_HOURS=

# ---- only for serving the UI from a different origin (Mac/Vercel) ----
# See upgrades-roadmap/mac-development.md. Leave all three unset for same-origin.
# Comma list of allowed browser origins for CORS.
PANEL_ORIGINS=
# lax (default) | none (required when UI and API are different sites; needs HTTPS)
PANEL_SAMESITE=
# Set to .yourdomain.com when UI and API are sibling subdomains (app.x / api.x).
PANEL_COOKIE_DOMAIN=
